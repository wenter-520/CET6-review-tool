```
CET6/
├── 词汇复习程序/
│   ├── index.html
│   ├── css/
│   │   └── app.css
│   ├── js/
│   │   ├── core.js
│   │   ├── filesync.js         ← 目录句柄同步
│   │   ├── store.js            ← 三方合并 + IndexedDB
│   │   ├── mastery.js
│   │   ├── scheduler.js
│   │   ├── session.js
│   │   ├── training.js
│   │   ├── analytics.js
│   │   ├── charts.js
│   │   ├── dashboard.js
│   │   ├── views.js
│   │   ├── app.js
│   │   └── xlsx.full.min.js
│   └── .userdata/              ← 数据目录（绑定后自动读写）
│       ├── states.json
│       ├── meta.json
│       ├── settings.json
│       ├── mastery.json
│       ├── training.json
│       ├── plan.json
│       └── sessions/
│           ├── 2026-10-04.json
│           ├── 2026-10-05.json
│           └── ...
├── synonyms.json           ← 近义词典（可选）
├── typo_hints.json         ← 拼写提示（可选）
├── collocations.json       ← 常用搭配（可选）
├── learning_plan.json      ← 学习计划（可选）
├── 第一天词汇学习.xlsx
